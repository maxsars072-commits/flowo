async function sendTelegramMessage(chatId, text) \{ if (!tgClient) return; await tgClient.sendMessage(chatId, \{ message: text \}); \}\
const \{ default: makeWASocket, useMultiFileAuthState \} = require('@whiskeysockets/baileys');\
const waSock = \{ current: null \};\
