\f0\fs24 \cf0 Sconst express = require('express');\
const WebSocket = require('ws');\
const http = require('http');\
const sqlite3 = require('sqlite3').verbose();\
const dotenv = require('dotenv');\
dotenv.config();\
const app = express();\
const server = http.createServer(app);\
const wss = new WebSocket.Server(\{ server \});\
const db = new sqlite3.Database('./klyo.db');\
db.serialize(() => \{\
  db.run(`CREATE TABLE IF NOT EXISTS messages (id INTEGER PRIMARY KEY AUTOINCREMENT, platform TEXT, chat_id TEXT, chat_name TEXT, sender TEXT, text TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)`);\
  db.run(`CREATE TABLE IF NOT EXISTS chats (id INTEGER PRIMARY KEY AUTOINCREMENT, platform TEXT, chat_id TEXT UNIQUE, chat_name TEXT, last_message TEXT, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP)`);\
\});\
app.use(express.json());\
app.use(express.static('public'));\
app.get('/api/chats', (req, res) => \{\
  db.all('SELECT * FROM chats ORDER BY updated_at DESC', (err, rows) => \{\
    if (err) return res.status(500).json(\{ error: err.message \});\
    res.json(rows);\
  \});\
\});\
app.get('/api/messages/:platform/:chat_id', (req, res) => \{\
  const \{ platform, chat_id \} = req.params;\
  db.all('SELECT * FROM messages WHERE platform = ? AND chat_id = ? ORDER BY created_at ASC', [platform, chat_id], (err, rows) => \{\
    if (err) return res.status(500).json(\{ error: err.message \});\
    res.json(rows);\
  \});\
\});\
app.post('/api/send', async (req, res) => \{\
  const \{ platform, chat_id, text \} = req.body;\
  if (platform === 'telegram') \{ await sendTelegramMessage(chat_id, text); \}\
  else if (platform === 'whatsapp') \{ await sendWhatsAppMessage(chat_id, text); \}\
  db.run('INSERT INTO messages (platform, chat_id, sender, text) VALUES (?, ?, ?, ?)', [platform, chat_id, 'me', text]);\
  res.json(\{ success: true \});\
\});\
wss.on('connection', (ws) => \{ ws.send(JSON.stringify(\{ type: 'connected', message: 'Klyo server connected' \})); \});\
function broadcast(message) \{ wss.clients.forEach((client) => \{ if (client.readyState === WebSocket.OPEN) \{ client.send(JSON.stringify(message)); \} \}); \}\
const \{ TelegramClient \} = require('telegram');\
const \{ StringSession \} = require('telegram/sessions');\
const input = require('input');\
const tgSession = new StringSession('');\
let tgClient = null;\
async function initTelegram() \{\
  const apiId = parseInt(process.env.TELEGRAM_API_ID);\
  const apiHash = process.env.TELEGRAM_API_HASH;\
  const phone = process.env.TELEGRAM_PHONE;\
  tgClient = new TelegramClient(tgSession, apiId, apiHash, \{ connectionRetries: 5, useWSS: true \});\
  await tgClient.start(\{\
    phoneNumber: async () => phone,\
    password: async () => await input.text('Password: '),\
    phoneCode: async () => await input.text('Code: '),\
    onError: (err) => console.log('Telegram error:', err),\
  \});\
  console.log('Telegram connected');\
  tgClient.addEventHandler(async (event) => \{\
    try \{\
      const message = event.message;\
      if (!message || !message.message) return;\
      const sender = await message.getSender();\
      const chat = await message.getChat();\
      const chatId = String(chat.id);\
      const chatName = chat.title || sender.firstName || 'Unknown';\
      const senderName = sender.firstName ? `$\{sender.firstName\} $\{sender.lastName || ''\}`.trim() : sender.username || 'Unknown';\
      db.run('INSERT INTO messages (platform, chat_id, chat_name, sender, text) VALUES (?, ?, ?, ?, ?)', ['telegram', chatId, chatName, senderName, message.message]);\
